# ==============================================================================
# SentinelEdge - Snort & Suricata Compatible Detection Rules
# Syntax conforms to standard Snort / Suricata rule format:
# action proto src_ip src_port -> dst_ip dst_port (msg:"..."; sid:...; rev:...;)
# ==============================================================================

# --- Port Scanning & Reconnaissance Signatures ---
alert tcp any any -> any any (msg:"SCAN Nmap SYN Scan Detected"; flags:S; threshold:type both, track by_src, count 8, seconds 2; sid:1000001; rev:1;)
alert tcp any any -> any any (msg:"SCAN Nmap NULL Scan (Stealth Probe)"; flags:0; sid:1000002; rev:1;)
alert tcp any any -> any any (msg:"SCAN Nmap Xmas Scan (FIN+PSH+URG)"; flags:FPU; sid:1000003; rev:1;)
alert tcp any any -> any any (msg:"SCAN Rapid Multi-Port Probe on Empty Ports"; threshold:type threshold, track by_src, count 10, seconds 3; sid:1000004; rev:1;)

# --- Web & Application Exploit Signatures ---
alert tcp any any -> any 80 (msg:"EXPLOIT SQL Injection Attempt (UNION SELECT)"; content:"UNION SELECT"; nocase; sid:1000010; rev:2;)
alert tcp any any -> any 8080 (msg:"EXPLOIT Apache Log4j RCE Attempt (jndi:ldap)"; content:"${jndi:ldap"; nocase; sid:1000011; rev:3;)
alert tcp any any -> any 80 (msg:"EXPLOIT Path Traversal Probe (/etc/passwd)"; content:"/etc/passwd"; sid:1000012; rev:1;)
alert tcp any any -> any 80 (msg:"EXPLOIT Shell Command Injection Probe (/bin/sh)"; content:"/bin/sh"; sid:1000013; rev:1;)

# --- DoS / Flood Signatures ---
alert tcp any any -> any any (msg:"DOS High Volume SYN Flood Burst"; flags:S; threshold:type both, track by_src, count 50, seconds 2; sid:1000020; rev:1;)
alert udp any any -> any any (msg:"DOS UDP Storm on Edge Router"; threshold:type threshold, track by_src, count 60, seconds 2; sid:1000021; rev:1;)

# --- Authentication Brute Force Signatures ---
alert tcp any any -> any 22 (msg:"AUTH SSH Multiple Rapid Connection Attempts"; threshold:type both, track by_src, count 12, seconds 4; sid:1000030; rev:1;)
alert tcp any any -> any 21 (msg:"AUTH FTP Brute Force Probe"; threshold:type both, track by_src, count 10, seconds 3; sid:1000031; rev:1;)
